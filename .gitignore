# Secrets — never commit. `.env.example` is the only env file that ships.
.env
.env.*
!.env.example
*.key
*.pem
.streamlit/secrets.toml

__pycache__/
*.pyc
.venv/
venv/

# Local seeded database — rebuilds itself from data/seed.py on first run.
data/*.db

# Verification runtime state — the simulated mailbox and CG outbox fill at demo time.
su_inbox/
cg_outbox/

# Personal working notes — kept on this machine, never published.
_private/

# Word owner/lock files, created while a .docx is open.
~$*
