# Copy this file to `.env` and paste your key. That is the only setup step.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for both the analytics planner and the vision extractor.
GEMINI_MODEL=gemini-flash-lite-latest

# If no key is present the app starts in DEMO MODE: canned, pre-recorded agent
# output for the sample documents and sample questions only. It is labelled
# loudly in the UI on every response. Set to "true" to force it even with a key.
FORCE_DEMO_MODE=false

# Folder the 'Load from folder' picker reads documents from.
# Relative to the project root, or an absolute path like C:/Users/you/inbox
DOC_INBOX=Testdocs
