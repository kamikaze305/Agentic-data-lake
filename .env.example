# Copy this file to `.env` and paste your key. That is the only required step.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Models ------------------------------------------------------------------
# Free-tier quota is per model, so the app walks a pool: a quota hit (429) or a
# retired model (404) moves to the next one. Leave both blank for the default
# pool (gemini-3.6-flash → 3.5-flash → 3.1-flash-lite → 3.5-flash-lite →
# gemini-flash-latest).
#
# Put one model at the front of the default pool:
GEMINI_MODEL=
# Or replace the pool entirely, comma-separated, tried in order:
GEMINI_MODELS=

# If no key is present the app starts in DEMO MODE: real SQL, pre-recorded
# extraction for the bundled documents, labelled loudly on every response.
# Set to "true" to force it even with a key.
FORCE_DEMO_MODE=false

# ---- Folders (relative to the project root, or absolute like C:/Users/you/inbox)
# The folder the Extract tab's "Load from folder" picker reads documents from.
DOC_INBOX=Testdocs
# The watched folder standing in for the CG team's mailbox.
SU_INBOX=su_inbox
# Where replies CG sends are written, one text file per send.
CG_OUTBOX=cg_outbox

# ---- Verification queue --------------------------------------------------------
# Minutes a document may wait for CG review before it counts as an SLA breach.
QUEUE_SLA_MINUTES=60
